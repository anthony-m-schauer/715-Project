*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# Local environments and secrets
.venv/
venv/
env/
ENV/
.conda/
conda-env/
.env
.env.*
!.env.example
*.pem
*.key

# Editor and operating system temporary files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Dataset contents; retain the directory placeholders
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
